# 可选的运行时覆盖项。模型服务和 API Key 均在设置页配置。

# 服务端。仅监听本机是安全默认值；只有在可信局域网中才使用 0.0.0.0。
NODE_ENV=development
HOST=127.0.0.1
PORT=17891
CORS_ORIGINS=http://localhost:17890,http://127.0.0.1:17890
TRUST_PROXY=false

# 运行时存储。相对路径以 backend/ 为基准解析。
DB_PATH=./data/database.sqlite
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=209715200

# PDF 提取安全限制。扫描版 PDF 即使没有 OCR 也仍可原版阅读。
MAX_PDF_PAGES=2000

# EPUB 提取安全限制。
MAX_EPUB_ENTRIES=10000
MAX_EPUB_UNCOMPRESSED_SIZE=1073741824
MAX_EPUB_ENTRY_SIZE=209715200
MAX_EPUB_COMPRESSION_RATIO=100

# AI 请求限制。服务地址和 API Key 均在设置页配置。
TRANSLATION_TIMEOUT_MS=180000
AI_CHAT_TIMEOUT_MS=180000
SUMMARY_TIMEOUT_MS=180000
READING_GUIDE_TIMEOUT_MS=300000
TRANSLATION_MAX_TOKENS=12000

# 翻译默认值，目标语言保持为中文。
TRANSLATION_SOURCE_LANG=en
TRANSLATION_TARGET_LANG=zh
TRANSLATION_MODE=normal
TRANSLATION_PROMPT_VERSION=v2
TRANSLATION_BATCH_SIZE=1
TRANSLATION_RETRY_COUNT=2
READING_GUIDE_MAX_INPUT_CHARS=120000

# Docker 托管的 Ollama 集成。普通 Node.js 启动时保持关闭，如需使用宿主机
# Ollama，请在设置页配置。Compose 会自动启用并注入内部服务地址。
OLLAMA_BOOTSTRAP_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BOOTSTRAP_URL=http://model-bootstrap:8080
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CONTEXT_WINDOW=32768
OLLAMA_MANAGED_NAME=本地 Ollama（Docker 托管）
OLLAMA_MANAGED_TIMEOUT_MS=1800000

# 批处理任务。
BATCH_CONCURRENCY=1
BATCH_RESUME_ACTIVE_HOURS=24
BATCH_SKIP_TRANSLATED=true

# 缓存。
CACHE_TTL=3600
CACHE_MAX_ENTRIES=1000
CACHE_CLEANUP_ENABLED=true
CACHE_CLEANUP_HOUR=2
CACHE_RETENTION_DAYS=30

# 文件存储。
USE_BLOB_STORAGE=false
COMPRESS_BLOBS=false
BLOB_COMPRESSION_LEVEL=6

# 可选的爱词霸兼容词典接口。未设置时，查词保持本地离线且不返回外部结果。
# DICTIONARY_API_URL=https://dict-mobile.iciba.com/interface/index.php
