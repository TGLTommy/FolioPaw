# 可选的 Docker 部署覆盖项。普通用户无需修改此文件。
# 第三方服务地址、模型 ID 和 API Key 均在 FolioPaw 设置页配置。

# FolioPaw 浏览器访问端口（仅绑定到 127.0.0.1）。
FOLIOPAW_PORT=17890

# 用于可复现构建的基础镜像。Docker Hub 不可用时可替换这些值，
# 并应单独为 Docker 守护进程配置可信的镜像源或代理。
NODE_IMAGE=node:22-bookworm-slim
OLLAMA_IMAGE=ollama/ollama:0.32.15
OLLAMA_ROCM_IMAGE=ollama/ollama:0.32.15-rocm
FOLIOPAW_IMAGE=foliopaw:local
MODEL_BOOTSTRAP_IMAGE=foliopaw-model-bootstrap:local

# 仅在构建 FolioPaw 镜像时使用的 npm 源。
NPM_REGISTRY=https://registry.npmjs.org
# 中国大陆可选地址（使用前请确认所在组织的安全策略）：
# NPM_REGISTRY=https://registry.npmmirror.com

# 模型选择与下载策略。
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CONTEXT_WINDOW=32768
OLLAMA_MANAGED_TIMEOUT_MS=1800000
OLLAMA_BOOTSTRAP_ENABLED=true
# FolioPaw 容器访问 Ollama 的地址。Compose 托管模式请保留默认值。
FOLIOPAW_OLLAMA_BASE_URL=http://ollama:11434
MODEL_DOWNLOAD_SOURCE=auto
MODEL_DOWNLOAD_IDLE_TIMEOUT_MS=90000

# local 模式：把 GGUF 放入 ./models，并按需修改容器内路径。
MODEL_LOCAL_GGUF_PATH=/models/Qwen_Qwen3.5-4B-Q4_K_M.gguf

# 模型下载使用的可选 HTTPS 出站代理。Ollama 仅接收 HTTPS_PROXY；
# NO_PROXY 中必须保留内部容器名称。
# HTTPS_PROXY=http://host.docker.internal:7890
FOLIOPAW_NO_PROXY=localhost,127.0.0.1,ollama,model-bootstrap,foliopaw
